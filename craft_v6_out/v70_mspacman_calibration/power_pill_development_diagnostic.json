  "audit_program": "import numpy as np,json,hashlib\nfrom pathlib import Path\nfrom collections import Counter\np=Path('craft_v6_out/v70_mspacman_calibration/development')\nm=json.loads((p/'manifest.json').read_text())\nrs=[];counts=[];eps=[]\nfor s in m['shards']:\n f=p/s['path'];assert hashlib.sha256(f.read_bytes()).hexdigest()==s['sha256']\n with np.load(f) as z:\n  rs.append(z['ram']);eps.append(z['episode'])\n  counts.append(np.stack([np.all(z['rgb'][:,y:y+7,x:x+4]==[228,111,111],axis=3).sum(axis=(1,2)) for x,y in [(148,146),(148,14),(8,147),(8,15)]],axis=1))\nr=np.concatenate(rs);c=np.concatenate(counts);e=np.concatenate(eps);v=c>0\nprev=np.r_[r[:1],r[:-1]];good=np.r_[False,e[1:]==e[:-1]];bits=np.array([4,8,16,32])\n\nfrom scipy import ndimage\nfrom datetime import datetime,timezone\nprev=np.r_[r[:1],r[:-1]];good=np.r_[False,e[1:]==e[:-1]]\nslots=[dict(bit=b,x=x,y=y,w=4,h=7) for b,x,y in [(4,148,146),(8,148,14),(16,8,147),(32,8,15)]]\nphase=np.stack([(r[:,30]&8)==0]*2+[(r[:,30]&8)>0]*2,axis=1)\npred=((r[:,117,None]&bits)>0)&phase\nassert np.array_equal(pred,v)\n# Revisit only existing arrays to assess bounding-box/fragment effects and keep discriminating examples.\ngeometry=Counter();colour_counts=Counter();partial_examples=[];event_examples=[]\nwitness_frames={1,8,9,16,17,184,185,256,257,264,265,2145,2146,2786,2787,2788,2789,4562,4563,6827,6828}\noffset=0\nfor shard in m['shards']:\n with np.load(p/shard['path']) as z:\n  for j,im in enumerate(z['rgb']):\n   i=offset+j\n   for k,s in enumerate(slots):\n    if not v[i,k]:continue\n    patch=im[s['y']:s['y']+7,s['x']:s['x']+4]\n    q=np.all(patch==[228,111,111],axis=2);ys,xs=np.where(q)\n    box=(int(xs.min()),int(ys.min()),int(xs.max()-xs.min()+1),int(ys.max()-ys.min()+1))\n    exact=box==(0,0,4,7)\n    edges=[box[0],box[1],box[0]+box[2]-4,box[1]+box[3]-7]\n    within=max(map(abs,edges))<=1\n    lab,nc=ndimage.label(q,np.ones((3,3),np.uint8))\n    geom4x7=any(t[0].stop-t[0].start==7 and t[1].stop-t[1].start==4 for t in ndimage.find_objects(lab))\n    geometry['visible_slots']+=1;geometry['bbox_exact']+=exact;geometry['bbox_within1']+=within\n    geometry['has_4x7_connected_component']+=geom4x7;geometry['multiple_fragments']+=nc>1\n    geometry['full_28_pixels']+=bool(q.all());geometry['partial_support']+=not q.all()\n    if not q.all():\n     colors,ns=np.unique(patch[~q],axis=0,return_counts=True)\n     for col,count in zip(colors,ns):colour_counts[tuple(map(int,col))]+=int(count)\n     if len(partial_examples)<12 or (not exact and not any(a['case']=='nonexact_bbox' for a in partial_examples)):\n      partial_examples.append(dict(frame=i+1,episode=int(e[i]),slot=s['bit'],support=[s['x'],s['y'],4,7],pink_pixels=int(q.sum()),visible_bbox=[s['x']+box[0],s['y']+box[1],box[2],box[3]],components=int(nc),component_4x7=bool(geom4x7),case='nonexact_bbox' if not exact else 'interior_occlusion',mask=[''.join('#' if b else '.' for b in row) for row in q],nonpink_colors=[dict(rgb=list(map(int,col)),pixels=int(count)) for col,count in zip(colors,ns)]))\n   if i+1 in witness_frames:\n    event_examples.append(dict(frame=i+1,episode=int(e[i]),ram30=int(r[i,30]),ram39=int(r[i,39]),ram117=int(r[i,117]),previous_ram30=int(prev[i,30]) if good[i] else None,previous_ram117=int(prev[i,117]) if good[i] else None,pink_pixels_by_slot=c[i].tolist()))\n offset+=shard['frames']\nvariants=[]\nfor phase_source in ('current','previous'):\n for flag_source in ('current','previous'):\n  rr=r if phase_source=='current' else prev;rf=r if flag_source=='current' else prev\n  pp=((rf[:,117,None]&bits)>0)&np.stack([(rr[:,30]&8)==0]*2+[(rr[:,30]&8)>0]*2,axis=1)\n  mask=np.ones(len(e),bool) if phase_source==flag_source=='current' else good\n  bad=np.flatnonzero(np.any(pp!=v,axis=1)&mask)\n  variants.append(dict(phase_source=phase_source,flag_source=flag_source,eligible_frames=int(mask.sum()),mismatch_frames=len(bad),mismatch_slots=int(((pp!=v)&mask[:,None]).sum()),first_mismatch_frames=(bad[:12]+1).tolist()))\nwrong39=((r[:,117,None]&bits)>0)&np.stack([r[:,39]%2==0]*2+[r[:,39]%2==1]*2,axis=1)\nepstats=[]\nfor ep in np.unique(e):\n mask=e==ep;ix=np.flatnonzero(mask)\n epstats.append(dict(episode=int(ep),first_frame=int(ix[0]+1),last_frame=int(ix[-1]+1),frames=int(mask.sum()),visible_slots=int(v[mask].sum()),left_visible_slots=int(v[mask,2:].sum()),right_visible_slots=int(v[mask,:2].sum()),mismatch_slots=int((v[mask]!=pred[mask]).sum()),ram30_unique_values=len(np.unique(r[mask,30])),phase_switches=int(((r[1:,30]&8)!=(r[:-1,30]&8))[mask[1:]&good[1:]].sum())))\nresult=dict(kind='mspacman_power_pill_development_diagnostic',created_utc=datetime.now(timezone.utc).isoformat(),\n reviewer='Codex independent subagent /root/audit_gate_v62',seed=17411,baseline_commit='c8e64ef',\n manifest_sha256=hashlib.sha256((p/'manifest.json').read_bytes()).hexdigest(),\n baseline_result_sha256=hashlib.sha256((p.parent/'development_baseline.json').read_bytes()).hexdigest(),\n baseline_source_sha256=json.loads((p.parent/'development_baseline.json').read_text())['source_sha256'],\n shards_checked=m['shards'],frames=len(e),charged_frames=m['accounting']['charged_frames'],cold_loads=m['accounting']['cold_loads'],\n candidate_rule=dict(runtime_inputs='CURRENT RAM[30] and CURRENT RAM[117] only',expression='active=bool(ram[117]&slot.bit); phase_visible=bool(ram[30]&8) for LEFT, not bool(ram[30]&8) for RIGHT; visible_support=active and phase_visible',slots=slots,active_flag_values=dict(Counter(map(int,r[:,117])))),\n pixel_measurement='For each nominal4x7 support count exact RGB(228,111,111) pixels. Presence is any surviving pink pixel, so occluded/fragmented rectangles remain included. This development diagnostic uses known positions for localization; it is not the independent runtime RGB checker.',\n presence=dict(slot_images=len(e)*4,agreeing_slot_images=int((pred==v).sum()),matching_frames=int(np.all(pred==v,axis=1).sum()),all_observed_ram30_values=len(np.unique(r[:,30])),wrong_initial_ram39_parity_mismatch_frames=int(np.any(wrong39!=v,axis=1).sum()),previous_ram_variants=variants),\n geometry={k:int(v) for k,v in geometry.items()},nonpink_pixels_on_partial_support=[dict(rgb=list(k),pixels=n) for k,n in sorted(colour_counts.items())],\n episodes=epstats,event_examples=event_examples,partial_support_examples=partial_examples,\n limits=['Development-only correlation across8192frames of one seed and four cold episodes with the same deterministic hardware start; not four independent initial phases.',\n 'All256 values of RAM[30] are observed in every episode. Current RAM counter bit8 predicts sides throughout wraps and gameplay; no fitted offset or absolute frame parity is used.',\n 'RAM[39] parity is rejected: it only proxies phase during the start and gives3057mismatch frames overall.',\n 'Four first frames have no archived same-episode predecessor; current-RAM candidate includes them and matches; previous-RAM comparisons exclude only those four explicitly.',\n 'One powerpill consumption of left-bottom is observed (frame2788); other slot removals, other mazes and newly entered levels are untested.',\n 'The phase/availability rule gives nominal visible supports, not full occlusion-aware geometry. Pink pixels missing under other colors must stay measured; do not drop these frames.',\n 'The measurement localizes at the four nominal supports, so it cannot by itself establish a global independent RGB checker free of maze-decor false positives.',\n 'No reserved capture, ROM or emulator was opened; no training or existing source/artifact was changed.'],\n recommended_next_step='Implement the current-RAM phase/availability hypothesis with development regression witnesses and independently measure remaining RGB geometry/occlusion failures without changing frozen thresholds.',\n reserved_opened=False,source_modified=False)\nprint(json.dumps(result,indent=2,allow_nan=False))\n"
